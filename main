-- ══════════════════════════════════════════════════════════════
--  §19  HIGHLIGHTS
-- ══════════════════════════════════════════════════════════════

local hlFolder=Instance.new("Folder")
hlFolder.Name="ENI_HL"; hlFolder.Parent=game:GetService("CoreGui")
local charHL={}

local function clearHL(model)
    local h=charHL[model]
    if h then pcall(function() h:Destroy() end); charHL[model]=nil end
end
local function ensureHL(model,color,trans,enabled)
    if not enabled or not model then clearHL(model); return end
    local h=charHL[model]
    if not h or not h.Parent then
        clearHL(model)
        h=Instance.new("Highlight")
        h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent=hlFolder; charHL[model]=h
    end
    h.Adornee=model; h.FillColor=color; h.OutlineColor=color
    h.FillTransparency=trans; h.OutlineTransparency=math.clamp(trans-0.15,0,1)
    h.Enabled=true
end
Players.PlayerRemoving:Connect(function(p)
    if p.Character then clearHL(p.Character) end
end)

-- ══════════════════════════════════════════════════════════════
--  §20  TARGETING  (fixed — no ground lock)
-- ══════════════════════════════════════════════════════════════

local AIM_ALL={"Head","HumanoidRootPart","UpperTorso","Torso","LowerTorso"}

local function partOf(char,name)
    local p=char:FindFirstChild(name)
    if p and p:IsA("BasePart") then return p end
    p=char:FindFirstChild(name,true)
    if p and p:IsA("BasePart") then return p end
    return nil
end
local function isCharPart(part,char)
    if not part or not part:IsA("BasePart") then return false end
    if not part:IsDescendantOf(char) then return false end
    local n=part.Name:lower()
    if n:find("weapon") or n:find("tool") or n:find("handle") then return false end
    if n:find("accessory") or n:find("gun") or n:find("blade") then return false end
    if n:find("floor") or n:find("ground") or n:find("baseplate") then return false end
    return true
end
local function firstValid(char,list)
    for _,name in ipairs(list) do
        local p=partOf(char,name)
        if p and isCharPart(p,char) then return p end
    end
    return nil
end
local function getHitPart(char)
    local mode=C.HitPart
    if mode=="Head" then
        return firstValid(char,{"Head"}) or firstValid(char,{"HumanoidRootPart","UpperTorso","Torso"})
    elseif mode=="Body" then
        return firstValid(char,{"HumanoidRootPart","UpperTorso","Torso"}) or firstValid(char,{"Head"})
    elseif mode=="Random" then
        local pool={}
        for _,name in ipairs(AIM_ALL) do
            local p=partOf(char,name)
            if p and isCharPart(p,char) then table.insert(pool,p) end
        end
        if #pool==0 then return firstValid(char,{"Head"}) end
        return pool[math.random(1,#pool)]
    else
        local center=Cam.ViewportSize/2
        local best,bestD=nil,math.huge
        for _,name in ipairs(AIM_ALL) do
            local p=partOf(char,name)
            if p and isCharPart(p,char) then
                local v,on=Cam:WorldToViewportPoint(p.Position)
                if on and v.Z>1 then
                    local d=(Vector2.new(v.X,v.Y)-center).Magnitude
                    if d<bestD then bestD=d; best=p end
                end
            end
        end
        return best or firstValid(char,{"Head"})
    end
end
local function aimPos(part)
    if not part then return nil end
    local n=part.Name
    if n=="Head" then return part.Position+Vector3.new(0,part.Size.Y*0.15,0)
    elseif n=="HumanoidRootPart" or n=="Torso" or n=="UpperTorso" then
        return part.Position+Vector3.new(0,0.5,0)
    end
    return part.Position
end
local function alive(char)
    if not char then return false end
    local h=char:FindFirstChildOfClass("Humanoid")
    return h and h.Health>0
end
local function sameTeam(p)
    return LP.Team and p.Team and LP.Team==p.Team
end
local function hasLOS(char,pos)
    local origin=Cam.CFrame.Position; local dir=pos-origin
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    local f={Cam}
    if LP.Character then table.insert(f,LP.Character) end
    params.FilterDescendantsInstances=f; params.IgnoreWater=true
    local hit=workspace:Raycast(origin,dir,params)
    if not hit then return true end
    return hit.Instance:IsDescendantOf(char)
end
local function toScreen(pos)
    local v,on=Cam:WorldToViewportPoint(pos)
    if not on or v.Z<=1 then return Vector2.new(v.X,v.Y),false end
    return Vector2.new(v.X,v.Y),true
end
local function getTarget()
    local center=Cam.ViewportSize/2
    local best,bestD=nil,math.huge
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP and not(C.TeamCheck and sameTeam(plr)) then
            local char=plr.Character
            if alive(char) then
                local part=getHitPart(char)
                if part then
                    local world=aimPos(part)
                    local s,on=toScreen(world)
                    if on then
                        local d=(s-center).Magnitude
                        if d<=C.FOVSize then
                            local ok=not C.WallCheck or hasLOS(char,world)
                            if ok and d<bestD then
                                bestD=d
                                best={player=plr,char=char,part=part,world=world,screen=s}
                            end
                        end
                    end
                end
            end
        end
    end
    return best
end

-- ══════════════════════════════════════════════════════════════
--  §21  SILENT AIM  (Mouse spoof — primary mechanism)
-- ══════════════════════════════════════════════════════════════

local silentTarget=nil
local mtOk,mt_mouse=pcall(getrawmetatable,Mouse)
if mtOk and mt_mouse then
    local oldIdx=mt_mouse.__index
    pcall(function()
        _setro(mt_mouse,false)
        mt_mouse.__index=_newcc(function(self,key)
            if C.SilentAim and silentTarget then
                if key=="Hit"    then return CFrame.new(silentTarget.Position) end
                if key=="Target" then return silentTarget end
            end
            return oldIdx(self,key)
        end)
        _setro(mt_mouse,true)
    end)
end

-- ══════════════════════════════════════════════════════════════
--  §22  TRIGGER + NO SPREAD
-- ══════════════════════════════════════════════════════════════

local function triggerClick()
    if mouse1click then pcall(mouse1click)
    elseif mouse1press and mouse1release then
        pcall(mouse1press); task.wait(0.02); pcall(mouse1release) end
end

local spreadHooks={conn=nil,oldRandom=nil}
local SPREAD_ATTRS={"Spread","BulletSpread","SpreadAngle","HipFireSpread","ADSSpread",
    "MinSpread","MaxSpread","CurrentSpread","Accuracy","Inaccuracy",
    "Bloom","Recoil","RecoilPower","VerticalRecoil","HorizontalRecoil","CameraShake","Shake"}

local function zeroGunStats(inst)
    if not inst then return end
    for _,name in ipairs(SPREAD_ATTRS) do
        local ok,val=pcall(function() return inst:GetAttribute(name) end)
        if ok and typeof(val)=="number" then pcall(function() inst:SetAttribute(name,0) end) end
        local child=inst:FindFirstChild(name,true)
        if child and (child:IsA("NumberValue") or child:IsA("IntValue")) then
            pcall(function() child.Value=0 end)
        end
    end
end
local function scanTools()
    local function scan(con)
        if not con then return end
        for _,t in ipairs(con:GetChildren()) do
            if t:IsA("Tool") or t:IsA("Model") then zeroGunStats(t) end
        end
    end
    scan(LP.Character); scan(LP:FindFirstChild("Backpack"))
end
local function enableNoSpread(on)
    if spreadHooks.conn then spreadHooks.conn:Disconnect(); spreadHooks.conn=nil end
    if spreadHooks.oldRandom then
        pcall(function() math.random=spreadHooks.oldRandom end); spreadHooks.oldRandom=nil
    end
    if not on then return end
    spreadHooks.conn=RS.Heartbeat:Connect(function()
        if not C.NoSpread then return end; scanTools()
    end)
    spreadHooks.oldRandom=math.random
    math.random=function(a,b)
        if C.NoSpread and UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
            if a~=nil and b~=nil then return math.floor((a+b)/2)
            elseif a~=nil then return math.floor(a/2) end
            return 0.5
        end
        if a~=nil and b~=nil then return spreadHooks.oldRandom(a,b)
        elseif a~=nil then return spreadHooks.oldRandom(a) end
        return spreadHooks.oldRandom()
    end
    scanTools()
end
local function hookContainer(con)
    if not con then return end
    con.ChildAdded:Connect(function(ch)
        if C.NoSpread and (ch:IsA("Tool") or ch:IsA("Model")) then
            task.defer(function() zeroGunStats(ch) end)
        end
    end)
end
hookContainer(LP:FindFirstChild("Backpack"))
if LP.Character then hookContainer(LP.Character) end
LP.CharacterAdded:Connect(function(char)
    task.wait(0.3); hookContainer(char)
    if C.NoSpread then scanTools() end
end)

-- ══════════════════════════════════════════════════════════════
--  §23  MOVEMENT
-- ══════════════════════════════════════════════════════════════

local function getRoot(char)
    return char and (partOf(char,"HumanoidRootPart") or
        partOf(char,"Torso") or partOf(char,"UpperTorso"))
end
local bVel,bGyro
local function stopFlight()
    if bVel  then pcall(function() bVel:Destroy()  end); bVel=nil end
    if bGyro then pcall(function() bGyro:Destroy() end); bGyro=nil end
end
local function startFlight(root)
    stopFlight()
    bVel=Instance.new("BodyVelocity")
    bVel.MaxForce=Vector3.new(1e5,1e5,1e5); bVel.Velocity=Vector3.zero
    bVel.Parent=root
    bGyro=Instance.new("BodyGyro")
    bGyro.MaxTorque=Vector3.new(1e5,1e5,1e5); bGyro.P=1e4
    bGyro.Parent=root
end
local noclipConn
local function setNoclip(on)
    if noclipConn then noclipConn:Disconnect(); noclipConn=nil end
    if not on then
        local char=LP.Character
        if char then
            for _,p in ipairs(char:GetDescendants()) do
                if p:IsA("BasePart") then p.CanCollide=true end
            end
        end
        return
    end
    noclipConn=RS.Stepped:Connect(function()
        local char=LP.Character; if not char then return end
        for _,p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide=false end
        end
    end)
end
local function applySpeed()
    local char=LP.Character; if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed=C.Speed and C.SpeedValue or 16 end
end
UIS.JumpRequest:Connect(function()
    if not C.InfJump then return end
    local char=LP.Character; if not char then return end
    local hum=char:FindFirstChildOfClass("Humanoid")
    if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
end)
LP.CharacterAdded:Connect(function()
    task.wait(0.5); applySpeed(); stopFlight()
end)

-- ══════════════════════════════════════════════════════════════
--  §24  MAIN RENDER LOOP
-- ══════════════════════════════════════════════════════════════

local prevCF=nil; local trigCD=0; local guiVisible=true
local prevNoSpread=C.NoSpread

RS.RenderStepped:Connect(function(dt)
    Cam=workspace.CurrentCamera
    local center=Cam.ViewportSize/2

    -- FOV circle
    local showFOV=C.ShowFOV and (C.SilentAim or C.TriggerBot) and guiVisible
    FOV.Visible=showFOV; CenterDot.Visible=showFOV
    if showFOV then
        FOV.Position=center; FOV.Radius=C.FOVSize; CenterDot.Position=center
    end

    -- target
    local tgt=nil
    if C.SilentAim or C.TriggerBot then
        tgt=getTarget(); silentTarget=tgt and tgt.part or nil
    else silentTarget=nil end

    -- trigger bot
    if C.TriggerBot and tgt then
        trigCD=trigCD-dt
        if trigCD<=0 then triggerClick(); trigCD=0.08 end
    end

    -- silent aim mmr assist (secondary — mouse spoof is primary)
    if C.SilentAim and tgt and HAS_MMR then
        local delta=tgt.screen-center
        if delta.Magnitude>2 then mmr(delta.X*0.35,delta.Y*0.35) end
    end

    -- no recoil
    if C.NoRecoil then
        local cur=Cam.CFrame
        if prevCF then
            local _,prevP=prevCF:ToEulerAnglesYXZ()
            local _,curP=cur:ToEulerAnglesYXZ()
            local d=curP-prevP
            if d>0.0004 then
                if HAS_MMR then
                    local ppr=Cam.ViewportSize.Y/math.rad(Cam.FieldOfView)
                    mmr(0,d*ppr*1.15)
                else
                    local x,y,z=cur:ToEulerAnglesYXZ()
                    pcall(function()
                        Cam.CFrame=CFrame.new(cur.Position)*CFrame.fromEulerAnglesYXZ(x-d,y,z)
                    end)
                end
            end
        end
        prevCF=Cam.CFrame
    else prevCF=nil end

    -- no spread watch
    if C.NoSpread~=prevNoSpread then
        prevNoSpread=C.NoSpread; enableNoSpread(C.NoSpread)
    end
    if C.NoSpread then scanTools() end

    -- flight
    local char=LP.Character; local root=char and getRoot(char)
    if C.Flight and root then
        if not bVel or bVel.Parent~=root then startFlight(root) end
        local dir=Vector3.zero
        if UIS:IsKeyDown(Enum.KeyCode.W) then dir=dir+Cam.CFrame.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.S) then dir=dir-Cam.CFrame.LookVector  end
        if UIS:IsKeyDown(Enum.KeyCode.A) then dir=dir-Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then dir=dir+Cam.CFrame.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space)      then dir=dir+Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl)
        or UIS:IsKeyDown(Enum.KeyCode.LeftShift)  then dir=dir-Vector3.new(0,1,0) end
        bVel.Velocity=dir.Magnitude>0 and dir.Unit*C.FlightSpeed or Vector3.zero
        bGyro.CFrame=Cam.CFrame
    else stopFlight() end

    if C.Speed then applySpeed() end

    -- highlights
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr~=LP then
            local ch=plr.Character
            if alive(ch) then
                if sameTeam(plr) then
                    ensureHL(ch,Color3.fromRGB(60,140,255),0.5,C.TeamHL)
                else
                    ensureHL(ch,Color3.fromRGB(255,60,60),0.4,C.EnemyHL)
                end
            else if ch then clearHL(ch) end end
        end
    end
    if C.NPCHL then
        for _,model in ipairs(workspace:GetDescendants()) do
            if model:IsA("Model") and model~=LP.Character then
                local hum=model:FindFirstChildOfClass("Humanoid")
                local isPlr=Players:GetPlayerFromCharacter(model)
                if hum and hum.Health>0 and not isPlr then
                    ensureHL(model,Color3.fromRGB(255,200,50),0.5,true)
                end
            end
        end
    end
end)

-- ══════════════════════════════════════════════════════════════
--  §25  GUI TOGGLE
-- ══════════════════════════════════════════════════════════════

local function toggleGui()
    guiVisible=not guiVisible
    if guiVisible then
        Win.Visible=true; BorderOuter.Visible=true; GlowFrame.Visible=true
        TwBack(Win,0.35,{
            Size=UDim2.new(0,444,0,528),
            Position=UDim2.new(0.5,-222,0.5,-264),
            BackgroundTransparency=0,
        })
    else
        Tw(Win,0.25,{Size=UDim2.new(0,444,0,10),BackgroundTransparency=0.9})
        task.delay(0.26,function()
            Win.Visible=false; BorderOuter.Visible=false; GlowFrame.Visible=false
        end)
    end
end

if not isMobile then
    UIS.InputBegan:Connect(function(i,gp)
        if gp then return end
        if i.KeyCode==Enum.KeyCode.K then toggleGui() end
    end)
end

if isMobile then
    local fb=N("TextButton",{
        Name="ENI_Toggle",
        Size=UDim2.new(0,48,0,48),
        Position=UDim2.new(0,8,0.5,-24),
        BackgroundColor3=P.PURP,
        BorderSizePixel=0,Text="◈",TextColor3=P.TEXT,
        Font=Enum.Font.GothamBold,TextSize=22,ZIndex=10,
        Parent=Screen,
    })
    Cr(fb,14); St(fb,P.CYAN,1)
    coroutine.wrap(function()
        while fb.Parent do
            Tw(fb,1.2,{BackgroundColor3=P.BLUE})
            task.wait(1.2)
            Tw(fb,1.2,{BackgroundColor3=P.PURP})
            task.wait(1.2)
        end
    end)()
    do
        local fd,fs,fp,mv=false,nil,nil,false
        fb.InputBegan:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.Touch then
                fd=true; mv=false; fs=i.Position; fp=fb.Position
            end
        end)
        UIS.InputChanged:Connect(function(i)
            if fd and i.UserInputType==Enum.UserInputType.Touch then
                local d=i.Position-fs
                if d.Magnitude>6 then mv=true end
                fb.Position=UDim2.new(fp.X.Scale,fp.X.Offset+d.X,fp.Y.Scale,fp.Y.Offset+d.Y)
            end
        end)
        UIS.InputEnded:Connect(function(i)
            if i.UserInputType==Enum.UserInputType.Touch then
                fd=false; if not mv then toggleGui() end
            end
        end)
    end
end

-- ══════════════════════════════════════════════════════════════
--  §26  CLEANUP
-- ══════════════════════════════════════════════════════════════

LP.AncestryChanged:Connect(function()
    pcall(function() FOV:Remove() end)
    pcall(function() CenterDot:Remove() end)
    for model in pairs(charHL) do clearHL(model) end
    pcall(function() hlFolder:Destroy() end)
    stopFlight()
    if noclipConn then noclipConn:Disconnect() end
    if spreadHooks.conn then spreadHooks.conn:Disconnect() end
    if spreadHooks.oldRandom then math.random=spreadHooks.oldRandom end
    pcall(function() Screen:Destroy() end)
end)

print("[ENI v4.0 NEON GLASS] ready — "..(isMobile and (isXeno and "Xeno" or "Zynova") or "Desktop"))
