-- section header
local function mkSec(parent,text,order)
    local row=N("Frame",{Size=UDim2.new(1,0,0,28),
        BackgroundTransparency=1,LayoutOrder=order or 0,Parent=parent})
    local dot=N("Frame",{Size=UDim2.new(0,4,0,4),Position=UDim2.new(0,2,0.5,-2),
        BackgroundColor3=P.CYAN,BorderSizePixel=0,Parent=row})
    Cr(dot,2)
    N("TextLabel",{Size=UDim2.new(1,-14,1,0),Position=UDim2.new(0,10,0,0),
        BackgroundTransparency=1,Text=text:upper(),TextColor3=P.CYAN,
        Font=Enum.Font.GothamBold,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,Parent=row})
    local line=N("Frame",{Size=UDim2.new(0,0,0,1),Position=UDim2.new(0,10,1,-1),
        BackgroundColor3=P.BORDBR,BorderSizePixel=0,Parent=row})
    task.defer(function() Tw(line,0.5,{Size=UDim2.new(1,-10,0,1)}) end)
end

-- toggle
local function mkToggle(parent,label,key,order,onChange)
    local row=N("Frame",{Size=UDim2.new(1,0,0,40),
        BackgroundColor3=P.CARD,BorderSizePixel=0,
        LayoutOrder=order or 0,ZIndex=4,Parent=parent})
    Cr(row,8)
    local rowSt=St(row,C[key] and P.BORDBR or P.BORD,1)

    -- glowing left bar
    local bar=N("Frame",{Size=UDim2.new(0,3,0.6,0),Position=UDim2.new(0,0,0.2,0),
        BackgroundColor3=C[key] and P.CYAN or P.OFF,BorderSizePixel=0,ZIndex=5,Parent=row})
    Cr(bar,2)

    -- label
    local lblEl=N("TextLabel",{Size=UDim2.new(1,-60,1,0),Position=UDim2.new(0,12,0,0),
        BackgroundTransparency=1,Text=label,
        TextColor3=C[key] and P.TEXT or P.TEXTM,
        Font=Enum.Font.Gotham,TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=row})

    -- track
    local track=N("Frame",{Size=UDim2.new(0,34,0,18),Position=UDim2.new(1,-44,0.5,-9),
        BackgroundColor3=C[key] and P.ON or P.OFF,ZIndex=5,Parent=row})
    Cr(track,9)
    local tSt=St(track,C[key] and P.CYAN or P.BORD,1)

    -- inner glow layer on track
    local tGlow=N("Frame",{Size=UDim2.new(1,0,1,0),
        BackgroundColor3=P.CYAN,BackgroundTransparency=C[key] and 0.65 or 1,
        BorderSizePixel=0,ZIndex=5,Parent=track})
    Cr(tGlow,9)

    local knob=N("Frame",{
        Size=UDim2.new(0,12,0,12),
        Position=C[key] and UDim2.new(1,-15,0.5,-6) or UDim2.new(0,3,0.5,-6),
        BackgroundColor3=P.KNOB,ZIndex=6,Parent=track})
    Cr(knob,6)

    -- knob glow
    local kGlow=N("Frame",{Size=UDim2.new(2.5,0,2.5,0),
        AnchorPoint=Vector2.new(0.5,0.5),Position=UDim2.new(0.5,0,0.5,0),
        BackgroundColor3=P.CYAN,BackgroundTransparency=C[key] and 0.75 or 1,
        BorderSizePixel=0,ZIndex=5,Parent=knob})
    Cr(kGlow,12)

    local function setState(v)
        C[key]=v
        Tw(track,0.2,{BackgroundColor3=v and P.ON or P.OFF})
        Tw(tSt,0.2,{Color=v and P.CYAN or P.BORD})
        Tw(tGlow,0.2,{BackgroundTransparency=v and 0.65 or 1})
        Tw(bar,0.2,{BackgroundColor3=v and P.CYAN or P.OFF})
        Tw(kGlow,0.2,{BackgroundTransparency=v and 0.75 or 1})
        Tw(rowSt,0.2,{Color=v and P.BORDBR or P.BORD})
        Tw(lblEl,0.2,{TextColor3=v and P.TEXT or P.TEXTM})
        TwBack(knob,0.28,{Position=v and UDim2.new(1,-15,0.5,-6) or UDim2.new(0,3,0.5,-6)})
        if onChange then onChange(v) end
    end

    local hb=N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,Text="",ZIndex=7,Parent=row})
    hb.MouseButton1Click:Connect(function() setState(not C[key]) end)
    hb.TouchTap:Connect(function() setState(not C[key]) end)
    hb.MouseEnter:Connect(function() Tw(row,0.1,{BackgroundColor3=P.CARD2}) end)
    hb.MouseLeave:Connect(function() Tw(row,0.1,{BackgroundColor3=P.CARD}) end)
    return setState
end

-- slider
local function mkSlider(parent,label,key,minV,maxV,fmt,order,onChange)
    local row=N("Frame",{Size=UDim2.new(1,0,0,54),
        BackgroundColor3=P.CARD,BorderSizePixel=0,
        LayoutOrder=order or 0,ZIndex=4,Parent=parent})
    Cr(row,8); St(row,P.BORD,1)

    N("TextLabel",{Size=UDim2.new(0.58,0,0,22),Position=UDim2.new(0,12,0,4),
        BackgroundTransparency=1,Text=label,
        Font=Enum.Font.Gotham,TextSize=12,TextColor3=P.TEXTM,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=row})

    local valLbl=N("TextLabel",{Size=UDim2.new(0.42,-12,0,22),Position=UDim2.new(0.58,0,0,4),
        BackgroundTransparency=1,Font=Enum.Font.GothamBold,TextSize=12,
        TextColor3=P.CYAN,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=5,Parent=row})

    local track=N("Frame",{Size=UDim2.new(1,-24,0,5),Position=UDim2.new(0,12,0,34),
        BackgroundColor3=P.SLBAR,ZIndex=5,Parent=row})
    Cr(track,3)

    local fill=N("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=P.BLUE,ZIndex=5,Parent=track})
    Cr(fill,3)
    Grad(fill,P.BLUE,P.CYAN,0)

    -- fill glow
    local fillGlow=N("Frame",{Size=UDim2.new(1,0,3,0),Position=UDim2.new(0,0,0.5,-1),
        BackgroundColor3=P.CYAN,BackgroundTransparency=0.8,BorderSizePixel=0,ZIndex=4,Parent=fill})
    Cr(fillGlow,4)

    local knob=N("Frame",{Size=UDim2.new(0,14,0,14),
        AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=P.KNOB,
        Position=UDim2.new(0,0,0.5,0),ZIndex=6,Parent=track})
    Cr(knob,7)
    St(knob,P.CYAN,1)

    -- knob outer ring
    local kRing=N("Frame",{Size=UDim2.new(2,0,2,0),AnchorPoint=Vector2.new(0.5,0.5),
        Position=UDim2.new(0.5,0,0.5,0),BackgroundColor3=P.CYAN,
        BackgroundTransparency=0.8,BorderSizePixel=0,ZIndex=5,Parent=knob})
    Cr(kRing,12)

    local function setVal(v)
        v=math.clamp(v,minV,maxV); C[key]=v
        local pct=(v-minV)/(maxV-minV)
        fill.Size=UDim2.new(pct,0,1,0)
        knob.Position=UDim2.new(pct,0,0.5,0)
        valLbl.Text=string.format(fmt or "%g",v)
        if onChange then onChange(v) end
    end
    setVal(C[key])

    local sliding=false
    local function handle(pos)
        local a=track.AbsolutePosition; local s=track.AbsoluteSize
        local pct=math.clamp((pos.X-a.X)/s.X,0,1)
        local v=minV+pct*(maxV-minV)
        v=fmt=="%.2f" and math.floor(v*100+0.5)/100
          or fmt=="%.1f" and math.floor(v*10+0.5)/10
          or math.floor(v+0.5)
        setVal(v)
    end
    track.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            sliding=true; handle(i.Position)
            TwSpr(knob,0.3,{Size=UDim2.new(0,17,0,17)})
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if sliding and (i.UserInputType==Enum.UserInputType.MouseMovement
                     or i.UserInputType==Enum.UserInputType.Touch) then handle(i.Position) end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            sliding=false; TwBack(knob,0.2,{Size=UDim2.new(0,14,0,14)})
        end
    end)
    row.MouseEnter:Connect(function() Tw(row,0.1,{BackgroundColor3=P.CARD2}) end)
    row.MouseLeave:Connect(function() Tw(row,0.1,{BackgroundColor3=P.CARD}) end)
    return setVal
end

-- dropdown
local function mkDropdown(parent,label,opts,key,order,onChange)
    local open=false; local CLOSED=40; local OPTH=28

    local outer=N("Frame",{Size=UDim2.new(1,0,0,CLOSED),
        BackgroundColor3=P.CARD,BorderSizePixel=0,ClipsDescendants=true,
        LayoutOrder=order or 0,ZIndex=4,Parent=parent})
    Cr(outer,8)
    local outerSt=St(outer,P.BORD,1)

    N("TextLabel",{Size=UDim2.new(0.55,0,0,CLOSED),Position=UDim2.new(0,12,0,0),
        BackgroundTransparency=1,Text=label,TextColor3=P.TEXTM,
        Font=Enum.Font.Gotham,TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=outer})

    local valLbl=N("TextLabel",{Size=UDim2.new(0.45,-26,0,CLOSED),Position=UDim2.new(0.55,0,0,0),
        BackgroundTransparency=1,Text=C[key],TextColor3=P.CYAN,
        Font=Enum.Font.GothamBold,TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Right,ZIndex=5,Parent=outer})

    local arrow=N("TextLabel",{Size=UDim2.new(0,22,0,CLOSED),Position=UDim2.new(1,-24,0,0),
        BackgroundTransparency=1,Text="▾",TextColor3=P.TEXTD,
        Font=Enum.Font.GothamBold,TextSize=13,ZIndex=5,Parent=outer})

    local list=N("Frame",{Size=UDim2.new(1,-6,0,#opts*OPTH),
        Position=UDim2.new(0,3,0,CLOSED+2),
        BackgroundColor3=P.CARD2,BorderSizePixel=0,ZIndex=5,Parent=outer})
    Cr(list,6); St(list,P.BORDBR,1)
    N("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Parent=list})

    for i,opt in ipairs(opts) do
        local isSel=opt==C[key]
        local ob=N("TextButton",{Size=UDim2.new(1,0,0,OPTH),
            BackgroundColor3=isSel and P.HOVER or P.CARD2,
            BackgroundTransparency=isSel and 0 or 1,
            Text="",BorderSizePixel=0,LayoutOrder=i,ZIndex=6,Parent=list})
        -- colored left dot for selected
        if isSel then
            local sd=N("Frame",{Size=UDim2.new(0,3,0.5,0),Position=UDim2.new(0,0,0.25,0),
                BackgroundColor3=P.CYAN,BorderSizePixel=0,ZIndex=7,Parent=ob})
            Cr(sd,2)
        end
        N("TextLabel",{Size=UDim2.new(1,-14,1,0),Position=UDim2.new(0,10,0,0),
            BackgroundTransparency=1,Text=opt,
            TextColor3=isSel and P.CYAN or P.TEXTM,
            Font=isSel and Enum.Font.GothamBold or Enum.Font.Gotham,
            TextSize=12,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=7,Parent=ob})
        ob.MouseEnter:Connect(function() Tw(ob,0.08,{BackgroundTransparency=0,BackgroundColor3=P.HOVER}) end)
        ob.MouseLeave:Connect(function()
            if C[key]~=opt then Tw(ob,0.08,{BackgroundTransparency=1}) end
        end)
        local function sel()
            C[key]=opt; valLbl.Text=opt
            for _,ch in ipairs(list:GetChildren()) do
                if ch:IsA("TextButton") then
                    local l=ch:FindFirstChildOfClass("TextLabel")
                    if l then
                        local iN=l.Text==opt
                        l.TextColor3=iN and P.CYAN or P.TEXTM
                        l.Font=iN and Enum.Font.GothamBold or Enum.Font.Gotham
                        Tw(ch,0.1,{BackgroundTransparency=iN and 0 or 1,BackgroundColor3=P.HOVER})
                    end
                end
            end
            open=false
            Tw(outer,0.2,{Size=UDim2.new(1,0,0,CLOSED)})
            Tw(arrow,0.2,{Rotation=0})
            Tw(outerSt,0.15,{Color=P.BORD})
            if onChange then onChange(opt) end
        end
        ob.MouseButton1Click:Connect(sel)
        ob.TouchTap:Connect(sel)
    end

    local hdr=N("TextButton",{Size=UDim2.new(1,0,0,CLOSED),BackgroundTransparency=1,
        Text="",ZIndex=8,Parent=outer})
    local function toggleDD()
        open=not open
        local th=open and (CLOSED+4+#opts*OPTH) or CLOSED
        TwBack(outer,0.25,{Size=UDim2.new(1,0,0,th)})
        Tw(arrow,0.2,{Rotation=open and 180 or 0})
        Tw(outerSt,0.15,{Color=open and P.CYAN or P.BORD})
    end
    hdr.MouseButton1Click:Connect(toggleDD)
    hdr.TouchTap:Connect(toggleDD)
    outer.MouseEnter:Connect(function() if not open then Tw(outer,0.1,{BackgroundColor3=P.CARD2}) end end)
    outer.MouseLeave:Connect(function() if not open then Tw(outer,0.1,{BackgroundColor3=P.CARD}) end end)
end

-- button with shimmer
local function mkBtn(parent,label,order,col,onClick)
    col = col or P.CYAN
    local btn=N("TextButton",{Size=UDim2.new(1,0,0,38),
        BackgroundColor3=P.BTNBG,BorderSizePixel=0,
        Text="",AutoButtonColor=false,
        LayoutOrder=order or 0,ZIndex=4,ClipsDescendants=true,Parent=parent})
    Cr(btn,8)
    local bSt=St(btn,P.BORD,1)

    -- subtle gradient bg
    local btnGrad=N("Frame",{Size=UDim2.new(1,0,1,0),
        BackgroundColor3=col,BackgroundTransparency=0.92,
        BorderSizePixel=0,ZIndex=4,Parent=btn})
    Cr(btnGrad,8)

    N("TextLabel",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
        Text=label,TextColor3=P.TEXT,Font=Enum.Font.GothamBold,
        TextSize=12,ZIndex=5,Parent=btn})

    -- shimmer strip
    local shimmer=N("Frame",{
        Size=UDim2.new(0.25,0,2,0),
        Position=UDim2.new(-0.3,0,-0.5,0),
        BackgroundColor3=Color3.new(1,1,1),
        BackgroundTransparency=0.75,
        Rotation=12,BorderSizePixel=0,ZIndex=6,Parent=btn})

    btn.MouseEnter:Connect(function()
        Tw(btn,0.12,{BackgroundColor3=P.CARD2})
        Tw(bSt,0.12,{Color=col})
        Tw(btnGrad,0.12,{BackgroundTransparency=0.82})
        shimmer.Position=UDim2.new(-0.3,0,-0.5,0)
        Tw(shimmer,0.45,{Position=UDim2.new(1.2,0,-0.5,0)})
    end)
    btn.MouseLeave:Connect(function()
        Tw(btn,0.12,{BackgroundColor3=P.BTNBG})
        Tw(bSt,0.12,{Color=P.BORD})
        Tw(btnGrad,0.12,{BackgroundTransparency=0.92})
    end)

    -- ripple on click
    local function doClick()
        local ripple=N("Frame",{
            Size=UDim2.new(0,0,0,0),AnchorPoint=Vector2.new(0.5,0.5),
            Position=UDim2.new(0.5,0,0.5,0),
            BackgroundColor3=col,BackgroundTransparency=0.55,
            BorderSizePixel=0,ZIndex=4,Parent=btn})
        Cr(ripple,50)
        Tw(ripple,0.4,{Size=UDim2.new(2,0,4,0),BackgroundTransparency=1})
        task.delay(0.41,function() if ripple then ripple:Destroy() end end)
        if onClick then onClick() end
    end
    btn.MouseButton1Click:Connect(doClick)
    btn.TouchTap:Connect(doClick)
    return btn
end

-- textbox
local function mkTB(parent,ph,order)
    local con=N("Frame",{Size=UDim2.new(1,0,0,36),
        BackgroundColor3=P.INBG,BorderSizePixel=0,
        LayoutOrder=order or 0,ZIndex=4,Parent=parent})
    Cr(con,8)
    local cSt=St(con,P.BORD,1)
    local tb=N("TextBox",{Size=UDim2.new(1,-16,1,0),Position=UDim2.new(0,8,0,0),
        BackgroundTransparency=1,PlaceholderText=ph,PlaceholderColor3=P.TEXTD,
        Text="",TextColor3=P.TEXT,Font=Enum.Font.Gotham,TextSize=11,
        TextXAlignment=Enum.TextXAlignment.Left,ClearTextOnFocus=false,
        ZIndex=5,Parent=con})
    tb.Focused:Connect(function()  Tw(cSt,0.15,{Color=P.CYAN}) end)
    tb.FocusLost:Connect(function() Tw(cSt,0.15,{Color=P.BORD}) end)
    return tb
end

-- status label
local function mkStat(parent,order)
    return N("TextLabel",{Size=UDim2.new(1,0,0,14),BackgroundTransparency=1,
        Text="",TextColor3=P.CYAN,Font=Enum.Font.Gotham,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
        LayoutOrder=order or 0,Parent=parent})
end
local function flash(lbl,msg,err)
    lbl.Text=msg; lbl.TextColor3=err and P.RED or P.GREEN
    task.delay(2.5,function() lbl.Text="" end)
end

-- script loader card
local function mkScriptCard(parent,title,subtitle,url,order)
    local loaded=false
    local card=N("Frame",{Size=UDim2.new(1,0,0,72),
        BackgroundColor3=P.CARD,BorderSizePixel=0,
        LayoutOrder=order or 0,ZIndex=4,Parent=parent})
    Cr(card,10)
    local cSt=St(card,P.BORD,1)

    -- top gradient bar
    local topBar=N("Frame",{Size=UDim2.new(1,0,0,3),
        BackgroundColor3=P.CYAN,BorderSizePixel=0,ZIndex=5,Parent=card})
    Cr(topBar,3)
    Grad(topBar,P.PURP,P.CYAN,0)

    N("TextLabel",{Size=UDim2.new(0.7,0,0,22),Position=UDim2.new(0,12,0,8),
        BackgroundTransparency=1,Text=title,TextColor3=P.TEXT,
        Font=Enum.Font.GothamBold,TextSize=14,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=card})
    N("TextLabel",{Size=UDim2.new(0.7,0,0,16),Position=UDim2.new(0,12,0,30),
        BackgroundTransparency=1,Text=subtitle,TextColor3=P.TEXTM,
        Font=Enum.Font.Gotham,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=card})

    -- status dot
    local sdot=N("Frame",{Size=UDim2.new(0,7,0,7),
        Position=UDim2.new(0,12,0,52),
        BackgroundColor3=P.TEXTD,BorderSizePixel=0,ZIndex=5,Parent=card})
    Cr(sdot,4)
    local sLbl=N("TextLabel",{Size=UDim2.new(0.5,0,0,14),Position=UDim2.new(0,24,0,48),
        BackgroundTransparency=1,Text="Not loaded",TextColor3=P.TEXTD,
        Font=Enum.Font.Gotham,TextSize=9,
        TextXAlignment=Enum.TextXAlignment.Left,ZIndex=5,Parent=card})

    -- load button
    local loadBtn=N("TextButton",{
        Size=UDim2.new(0,70,0,28),
        Position=UDim2.new(1,-80,0.5,-14),
        BackgroundColor3=P.PURP,BackgroundTransparency=0.4,
        BorderSizePixel=0,Text="LOAD",TextColor3=P.TEXT,
        Font=Enum.Font.GothamBold,TextSize=11,
        AutoButtonColor=false,ZIndex=6,Parent=card})
    Cr(loadBtn,7); St(loadBtn,P.PURP,1)

    -- shimmer on load btn
    local lShimmer=N("Frame",{Size=UDim2.new(0.4,0,2,0),
        Position=UDim2.new(-0.4,0,-0.5,0),Rotation=12,
        BackgroundColor3=Color3.new(1,1,1),BackgroundTransparency=0.75,
        BorderSizePixel=0,ZIndex=7,Parent=loadBtn,ClipsDescendants=false})
    loadBtn.ClipsDescendants=true

    loadBtn.MouseEnter:Connect(function()
        Tw(loadBtn,0.15,{BackgroundTransparency=0.15})
        lShimmer.Position=UDim2.new(-0.4,0,-0.5,0)
        Tw(lShimmer,0.4,{Position=UDim2.new(1.3,0,-0.5,0)})
    end)
    loadBtn.MouseLeave:Connect(function() Tw(loadBtn,0.15,{BackgroundTransparency=0.4}) end)

    local function doLoad()
        if loaded then return end
        loaded=true
        Tw(loadBtn,0.2,{BackgroundTransparency=0.7})
        loadBtn.Text="..."
        Tw(sdot,0.2,{BackgroundColor3=P.CYAN})
        sLbl.Text="Loading..."
        Notify(title,"Script loading…","",2)
        task.spawn(function()
            local ok,err=pcall(function()
                loadstring(game:HttpGet(url,true))()
            end)
            if ok then
                loadBtn.Text="✓"
                Tw(sdot,0.2,{BackgroundColor3=P.GREEN})
                sLbl.Text="Loaded"
                sLbl.TextColor3=P.GREEN
                Tw(cSt,0.3,{Color=P.GREEN})
                Notify(title,"Loaded successfully","ok",3)
            else
                loaded=false
                loadBtn.Text="✗"
                Tw(sdot,0.2,{BackgroundColor3=P.RED})
                sLbl.Text="Failed"
                sLbl.TextColor3=P.RED
                Tw(loadBtn,0.2,{BackgroundTransparency=0.4})
                Notify(title,"Load failed","err",3)
                task.delay(1.5,function() if loadBtn.Parent then loadBtn.Text="LOAD" end end)
            end
        end)
    end
    loadBtn.MouseButton1Click:Connect(doLoad)
    loadBtn.TouchTap:Connect(doLoad)

    card.MouseEnter:Connect(function() Tw(card,0.12,{BackgroundColor3=P.CARD2}) end)
    card.MouseLeave:Connect(function() Tw(card,0.12,{BackgroundColor3=P.CARD}) end)
end

