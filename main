-- ══════════════════════════════════════════════════════════════
--  §0  EXECUTOR BRIDGE
-- ══════════════════════════════════════════════════════════════

local _exec    = (identifyexecutor and identifyexecutor():lower()) or ""
local isXeno   = (typeof(Xeno)   == "table") or _exec:find("xeno")   ~= nil
local isZynova = (typeof(zynova) == "table") or _exec:find("zynova") ~= nil
local isMobile = isXeno or isZynova

local function _b(n)
    for _, s in ipairs({syn, isXeno and Xeno or nil, isZynova and zynova or nil}) do
        if type(s)=="table" and type(s[n])=="function" then return s[n] end
    end
    return type(_G[n])=="function" and _G[n] or nil
end

local _writefile = _b("writefile")         or function() end
local _readfile  = _b("readfile")          or function() return nil end
local _isfile    = _b("isfile")            or function() return false end
local _setro     = _b("setreadonly")       or function() end
local _newcc     = _b("newcclosure")       or function(f) return f end
local _gncm      = _b("getnamecallmethod") or function() return "" end
local _setclip   = _b("setclipboard")      or function() end

local HAS_MMR = _b("mousemoverel") ~= nil
local function mmr(x,y)
    local f = _b("mousemoverel"); if f then f(x,y) end
end

local HAS_DRAWING = typeof(Drawing)=="table" and typeof(Drawing.new)=="function"
local function DrawNew(k)
    if HAS_DRAWING then
        local ok,o = pcall(Drawing.new,k)
        if ok and o then return o end
    end
    local t={Visible=false}
    return setmetatable(t,{__newindex=function(s,k2,v) rawset(s,k2,v) end,
        __index=function(_,k2) if k2=="Remove" then return function()end end end})
end

local function _guiParent()
    if syn and syn.protect_gui then return game:GetService("CoreGui") end
    local gh=_b("gethui"); if gh then return gh() end
    return game:GetService("CoreGui")
end
local function _protectGui(g)
    local f=(syn and syn.protect_gui) or _b("protect_gui")
    if f then pcall(f,g) end
end

-- ══════════════════════════════════════════════════════════════
--  §1  ANTICHEAT
-- ══════════════════════════════════════════════════════════════

local ok_ac,mt_ac = pcall(getrawmetatable,game)
if ok_ac and mt_ac then
    local oldNC=rawget(mt_ac,"__namecall")
    _setro(mt_ac,false)
    mt_ac.__namecall=_newcc(function(self,...)
        local m=_gncm()
        if m=="FireServer" or m=="InvokeServer" then
            local n=tostring(self.Name):lower()
            for _,w in ipairs({"anticheat","detect","report","flag","exploit","check",
                "monitor","kick","ban","log","scan","velocity","speed","fly","noclip",
                "esp","aimbot","cheat","hack","inject","suspicious","alert","security"}) do
                if n:find(w) then return nil end
            end
        end
        return oldNC(self,...)
    end)
    _setro(mt_ac,true)
end

