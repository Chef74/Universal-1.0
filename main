-- floating particles in title bar
coroutine.wrap(function()
    while TBar.Parent do
        local particle=N("Frame",{
            Size=UDim2.new(0,math.random(2,4),0,math.random(2,4)),
            Position=UDim2.new(math.random(5,90)/100,0,1,0),
            BackgroundColor3=math.random(2)==1 and P.CYAN or P.PURP,
            BackgroundTransparency=0.2,BorderSizePixel=0,ZIndex=4,Parent=TBar,
        })
        Cr(particle,2)
        Tw(particle,math.random(12,22)/10,{
            Position=UDim2.new(particle.Position.X.Scale,0,-0.3,0),
            BackgroundTransparency=1,
        })
        task.delay(2.3,function() if particle then particle:Destroy() end end)
        task.wait(0.35)
    end
end)()

-- drag (mouse + touch)
do
    local drag,ds,sp=false,nil,nil
    TBar.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then
            drag=true; ds=i.Position; sp=Win.Position
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if drag and (i.UserInputType==Enum.UserInputType.MouseMovement
                  or i.UserInputType==Enum.UserInputType.Touch) then
            local d=i.Position-ds
            local nx=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
            Win.Position=nx
            BorderOuter.Position=UDim2.new(nx.X.Scale,nx.X.Offset-2,nx.Y.Scale,nx.Y.Offset-2)
            GlowFrame.Position=UDim2.new(nx.X.Scale,nx.X.Offset-8,nx.Y.Scale,nx.Y.Offset-8)
        end
    end)
    UIS.InputEnded:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1
        or i.UserInputType==Enum.UserInputType.Touch then drag=false end
    end)
end

