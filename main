local function mkScroll(parent)
    local sf=N("ScrollingFrame",{
        Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
        BorderSizePixel=0,ScrollBarThickness=2,
        ScrollBarImageColor3=P.CYAN,CanvasSize=UDim2.new(0,0,0,0),
        AutomaticCanvasSize=Enum.AutomaticSize.Y,Visible=false,
        ZIndex=4,Parent=parent,
    })
    N("UIListLayout",{SortOrder=Enum.SortOrder.LayoutOrder,Padding=UDim.new(0,5),Parent=sf})
    N("UIPadding",{PaddingLeft=UDim.new(0,10),PaddingRight=UDim.new(0,10),
        PaddingTop=UDim.new(0,10),PaddingBottom=UDim.new(0,12),Parent=sf})
    return sf
end

