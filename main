local notifCount=0
local function Notify(title,body,ntype,dur)
    notifCount=notifCount+1
    local col = ntype=="err" and P.RED or ntype=="ok" and P.GREEN or P.CYAN

    local card=N("Frame",{
        Size=UDim2.new(1,0,0,0),
        BackgroundColor3=P.CARD2,
        BackgroundTransparency=0,
        BorderSizePixel=0,
        ClipsDescendants=true,
        ZIndex=200,
        LayoutOrder=notifCount,
        Parent=NotifBox,
    })
    Cr(card,8)
    St(card,col,1)

    -- left color bar
    local bar=N("Frame",{
        Size=UDim2.new(0,3,1,0),
        BackgroundColor3=col,
        BorderSizePixel=0,ZIndex=201,Parent=card,
    })
    Cr(bar,2)

    N("TextLabel",{
        Size=UDim2.new(1,-14,0,18),
        Position=UDim2.new(0,10,0,8),
        BackgroundTransparency=1,
        Text=title,TextColor3=col,
        Font=Enum.Font.GothamBold,TextSize=12,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=201,Parent=card,
    })
    N("TextLabel",{
        Size=UDim2.new(1,-14,0,14),
        Position=UDim2.new(0,10,0,26),
        BackgroundTransparency=1,
        Text=body,TextColor3=P.TEXTM,
        Font=Enum.Font.Gotham,TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
        ZIndex=201,Parent=card,
    })

    -- expand in
    TwBack(card,0.35,{Size=UDim2.new(1,0,0,50)})
    task.delay(dur or 3,function()
        Tw(card,0.25,{Size=UDim2.new(1,0,0,0),BackgroundTransparency=1})
        task.delay(0.26,function() card:Destroy() end)
    end)
end

