-- ══════════════════════════════════════════════════════════════
--  §3  CONFIG
-- ══════════════════════════════════════════════════════════════

local C = {
    SilentAim=false, TriggerBot=false, TeamCheck=true, WallCheck=true,
    ShowFOV=true, FOVSize=120, HitPart="Head",
    NoRecoil=false, NoSpread=false,
    Flight=false, FlightSpeed=50, Speed=false, SpeedValue=24,
    InfJump=false, NoClip=false,
    EnemyHL=false, TeamHL=false, NPCHL=false,
    AutoLoad=false,
}

local function Ser()   return HTTP:JSONEncode(C) end
local function ApplyJSON(j)
    local ok,d=pcall(HTTP.JSONDecode,HTTP,j)
    if not ok or type(d)~="table" then return false end
    for k,v in pairs(d) do if C[k]~=nil then C[k]=v end end
    return true
end
local function Save()  pcall(_writefile,CFFILE,Ser()) end
local function Load()
    local a,b=pcall(_isfile,CFFILE); if not a or not b then return false end
    local c,d=pcall(_readfile,CFFILE); if not c or not d then return false end
    return ApplyJSON(d)
end
if C.AutoLoad then Load() end

