local TABS={
    {lbl="COMBAT",   icon="◈", scr=SCR.Combat,   ord=1, color=P.CYAN},
    {lbl="WEAPON",   icon="⚡", scr=SCR.Weapon,   ord=2, color=P.PURP},
    {lbl="MOVEMENT", icon="✦", scr=SCR.Movement, ord=3, color=P.BLUE},
    {lbl="VISUAL",   icon="◉", scr=SCR.Visual,   ord=4, color=P.PINK},
    {lbl="SCRIPTS",  icon="↗", scr=SCR.Scripts,  ord=5, color=P.GREEN},
    {lbl="SETTINGS", icon="⚙", scr=SCR.Settings, ord=6, color=P.TEXTM},
}

local ROW_H=52
local activeScr=nil
local tabRefs={}   -- [scr]={bg,icon,lbl,color}

local function staggerIn(scr)
    local children=scr:GetChildren()
    local items={}
    for _,c in ipairs(children) do
        if c:IsA("Frame") or c:IsA("ScrollingFrame") then
            table.insert(items,c)
        end
    end
    for i,child in ipairs(items) do
        child.BackgroundTransparency=1
        task.delay(i*0.04,function()
            if child.Parent then
                Tw(child,0.2,{BackgroundTransparency=
                    (child.BackgroundColor3==P.CARD or child.BackgroundColor3==P.CARD2) and 0 or 1})
            end
        end)
    end
end

local function switchTab(scr,tabIdx,tabColor)
    if activeScr==scr then return end
    FadeOverlay.BackgroundTransparency=0.3
    Tw(FadeOverlay,0.18,{BackgroundTransparency=1})
    if activeScr then activeScr.Visible=false end
    activeScr=scr; scr.Visible=true
    task.defer(function() staggerIn(scr) end)

    -- slide pill
    local targetY=12+(tabIdx-1)*(ROW_H+2)+(ROW_H-32)/2
    TwBack(Pill,0.3,{Position=UDim2.new(1,-4,0,targetY)})
    Tw(Pill,0.3,{BackgroundColor3=tabColor})
    Tw(PillHalo,0.3,{BackgroundColor3=tabColor})

    for s,refs in pairs(tabRefs) do
        local active=(s==scr)
        Tw(refs.bg,   0.2,{BackgroundColor3=active and P.CARD2 or P.SIDE,
                            BackgroundTransparency=active and 0 or 1})
        local icol=active and refs.color or P.TEXTD
        Tw(refs.icon, 0.2,{TextColor3=icol})
        Tw(refs.lbl,  0.2,{TextColor3=active and P.TEXT or P.TEXTD})
        if active then
            -- pulse icon on select
            TwSpr(refs.icon,0.4,{TextSize=18})
            task.delay(0.1,function()
                if refs.icon.Parent then Tw(refs.icon,0.2,{TextSize=16}) end
            end)
        end
    end
end

for _,t in ipairs(TABS) do
    local row=N("Frame",{
        Size=UDim2.new(1,0,0,ROW_H),
        BackgroundTransparency=1,
        LayoutOrder=t.ord,ZIndex=4,Parent=Sidebar,
    })
    local bg=N("Frame",{
        Size=UDim2.new(1,0,1,0),
        BackgroundColor3=P.CARD2,BackgroundTransparency=1,
        BorderSizePixel=0,ZIndex=4,Parent=row,
    })
    Cr(bg,7)
    local icon=N("TextLabel",{
        Size=UDim2.new(1,0,0,22),Position=UDim2.new(0,0,0,7),
        BackgroundTransparency=1,Text=t.icon,
        TextColor3=P.TEXTD,Font=Enum.Font.GothamBold,TextSize=16,
        TextXAlignment=Enum.TextXAlignment.Center,ZIndex=5,Parent=row,
    })
    local lbl=N("TextLabel",{
        Size=UDim2.new(1,0,0,11),Position=UDim2.new(0,0,0,31),
        BackgroundTransparency=1,Text=t.lbl,
        TextColor3=P.TEXTD,Font=Enum.Font.GothamBold,TextSize=7,
        TextXAlignment=Enum.TextXAlignment.Center,ZIndex=5,Parent=row,
    })
    tabRefs[t.scr]={bg=bg,icon=icon,lbl=lbl,color=t.color}
    local tScr=t.scr; local tIdx=t.ord; local tCol=t.color
    local hb=N("TextButton",{Size=UDim2.new(1,0,1,0),BackgroundTransparency=1,
        Text="",ZIndex=6,Parent=row})
    hb.MouseButton1Click:Connect(function() switchTab(tScr,tIdx,tCol) end)
    hb.TouchTap:Connect(function() switchTab(tScr,tIdx,tCol) end)
    hb.MouseEnter:Connect(function()
        if activeScr~=tScr then
            Tw(bg,0.12,{BackgroundColor3=P.CARD,BackgroundTransparency=0})
            Tw(icon,0.12,{TextColor3=P.TEXTM})
        end
    end)
    hb.MouseLeave:Connect(function()
        if activeScr~=tScr then
            Tw(bg,0.12,{BackgroundTransparency=1})
            Tw(icon,0.12,{TextColor3=P.TEXTD})
        end
    end)
end

task.defer(function() switchTab(SCR.Combat,1,P.CYAN) end)

